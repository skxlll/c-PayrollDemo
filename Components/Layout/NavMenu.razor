@rendermode InteractiveServer

<aside class="side glass">
    <div class="logo"><i>◆</i> Finac</div>

    <div class="grp">OVERVIEW</div>
    <NavLink class="nav" href="dashboard" Match="NavLinkMatch.All">
       <div class="nav-label">
            <span>⌂</span>
            <span>Dashboard</span>
        </div>
    </NavLink>

    <div class="grp">MODULES</div>

    <!-- Master Files -->
    <div>
        <button type="button" class="nav @(expandMasterFiles ? "on" : "")" @onclick="ToggleMasterFiles">
            <div class="nav-label">
            <span>▤</span>
            <span>Master files</span>
        </div>
            <span class="chevron @(expandMasterFiles ? "rotate" : "")">▾</span>
        </button>
        @if (expandMasterFiles)
        {
            <div class="sub">
                <NavLink class="nav" href="employees">Employees</NavLink>
                <NavLink class="nav" href="departments">Departments</NavLink>
                <NavLink class="nav" href="salaryitem">Salary items</NavLink>
            </div>
        }
    </div>

    <!-- Transactions -->
    <div>
        <button type="button" class="nav @(expandTransactions ? "on" : "")" @onclick="ToggleTransactions">
        <div class="nav-label">
            <span>⇄</span>
            <span>Transactions</span>
        </div>
            <span class="chevron @(expandTransactions ? "rotate" : "")">▾</span>
        </button>
        @if (expandTransactions)
        {
            <div class="sub">
                <NavLink class="nav" href="salary-items">Salary item transactions</NavLink>
            </div>
        }
    </div>

    <!-- Processes -->
    <div>
        <button type="button" class="nav @(expandProcesses ? "on" : "")" @onclick="ToggleProcesses">
            
            <div class="nav-label">
            <span>⚙</span>
            <span>Processes</span>
        </div>
            <span class="chevron @(expandProcesses ? "rotate" : "")">▾</span>
        </button>
        @if (expandProcesses)
        {
            <div class="sub">
                <NavLink class="nav" href="salary-process">Salary process</NavLink>
            </div>
        }
    </div>

    <!-- Reports -->
    <div>
        <button type="button" class="nav @(expandReports ? "on" : "")" @onclick="ToggleReports">
           
            <div class="nav-label">
            <span>▥</span>
            <span>Reports</span>
        </div>
            <span class="chevron @(expandReports ? "rotate" : "")">▾</span>
        </button>
        @if (expandReports)
        {
            <div class="sub">
                <NavLink class="nav" href="payslip-report">Payslip report</NavLink>
                <NavLink class="nav" href="paysheet-report">Paysheet report</NavLink>
            </div>
        }
    </div>
</aside>

@code {
    private bool expandMasterFiles = true;
    private bool expandTransactions = false;
    private bool expandProcesses = false;
    private bool expandReports = false;

    private void ToggleMasterFiles() => expandMasterFiles = !expandMasterFiles;
    private void ToggleTransactions() => expandTransactions = !expandTransactions;
    private void ToggleProcesses() => expandProcesses = !expandProcesses;
    private void ToggleReports() => expandReports = !expandReports;
}