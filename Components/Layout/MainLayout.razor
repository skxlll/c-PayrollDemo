@inherits LayoutComponentBase

<div class="page" style="background-color: #f8f9fa; min-height: 100vh;">
    <div class="sidebar" style="background: linear-gradient(180deg, #091c28 0%, #183e54 100%);">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center shadow-sm" style="background-color: white; border-bottom: 1px solid #dee2e6;">
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small fw-semibold">Company: Finac Global</span>
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Sign Out</button>
            </div>
        </div>

        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>