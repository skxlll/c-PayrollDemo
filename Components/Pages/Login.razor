@page "/"
@using PayrollDemo.Core.Entities
@inject PayrollDemo.Core.Interfaces.IAuthService AuthService
@inject NavigationManager NavManager
@layout PayrollDemo.Components.Layout.LoginLayout
@rendermode InteractiveServer

<PageTitle>Finac | Login</PageTitle>

<div class="login-wrapper">
    <div class="login-card glass">
        
        <!-- Left Side: Branding -->
        <div class="brand-panel">
            <div class="brand-header">
                <div class="logo">
                    <i>◆</i>
                    <span>Finac</span>
                </div>
            </div>

            <div class="brand-body">
                <h1 class="brand-title">Autonomous<br/>Payroll<br/>Platform</h1>
                
                <ul class="feature-list">
                    <li>
                        <span class="feature-badge">✓</span>
                        <span>Enterprise-grade Security</span>
                    </li>
                    <li>
                        <span class="feature-badge">✓</span>
                        <span>Automated Tax Compliance</span>
                    </li>
                    <li>
                        <span class="feature-badge">✓</span>
                        <span>Real-time Workforce Analytics</span>
                    </li>
                </ul>
            </div>

            <div class="brand-footer">
                <small>© @DateTime.Now.Year Finac Inc. All rights reserved.</small>
            </div>
        </div>

        <!-- Right Side: Interactive Form -->
        <div class="form-panel">
            <div class="form-container">
                <h2 class="form-title">Welcome Back</h2>
                <p class="form-subtitle">Sign in to your Finac account to continue.</p>

                @if (!isStepTwo)
                {
                    <!-- Step 1 -->
                    <EditForm Model="@loginModel" OnValidSubmit="HandleStepOne">
                        <div class="field-group">
                            <label class="field-label">Email Address</label>
                            <InputText @bind-Value="loginModel.Username" class="in" placeholder="name@company.com" />
                        </div>

                        <div class="field-group">
                            <div class="label-row">
                                <label class="field-label">Password</label>
                                <a href="#" class="forgot-link">Forgot Password?</a>
                            </div>
                            <InputText @bind-Value="loginModel.Password" type="password" class="in" placeholder="••••••••" />
                        </div>

                        <button type="submit" class="frost-btn pri w-full">Sign In</button>
                    </EditForm>
                }
                else
                {
                    <!-- Step 2 -->
                    <EditForm Model="@selectionModel" OnValidSubmit="HandleStepTwo">
                        <div class="field-group">
                            <label class="field-label">Company Context</label>
                            <InputSelect @bind-Value="selectionModel.ComCode" class="in">
                                <option value="">-- Select Company --</option>
                                @foreach (var comp in dbCompanies)
                                {
                                    <option value="@comp.ComCode">@comp.ComName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="field-group">
                            <label class="field-label">Access Category</label>
                            <InputSelect @bind-Value="selectionModel.CatCode" class="in">
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in dbCategories)
                                {
                                    <option value="@cat.CatCode">@cat.CatName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="btn-group">
                            <button type="button" class="frost-btn back-btn" @onclick="GoBack">Back</button>
                            <button type="submit" class="frost-btn pri flex-1">Continue to Dashboard</button>
                        </div>
                    </EditForm>
                }

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="toast-error" role="alert">
                        @message
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private class LoginDto
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }

    private class SelectionDto
    {
        public string ComCode { get; set; } = "";
        public string CatCode { get; set; } = "";
    }

    private LoginDto loginModel = new();
    private SelectionDto selectionModel = new();
    private string message = "";
    private bool isStepTwo = false;

    private List<Company> dbCompanies = new();
    private List<Category> dbCategories = new();

    private async Task HandleStepOne()
{
    // Capture the returned User object instead of a boolean
    var user = await AuthService.ValidateUserAsync(loginModel.Username, loginModel.Password);

    // If a user was found, it is valid
    if (user != null)
    {
        message = "";
        dbCompanies = await AuthService.GetCompaniesAsync();
        dbCategories = await AuthService.GetCategoriesAsync(); 
        
        isStepTwo = true;
    }
    else
    {
        message = "Invalid username or password.";
    }
}

    private void HandleStepTwo()
    {
        if (string.IsNullOrEmpty(selectionModel.ComCode) || string.IsNullOrEmpty(selectionModel.CatCode))
        {
            message = "Please select both a Company and a Category.";
            return;
        }

        NavManager.NavigateTo("/dashboard");
    }

    private void GoBack()
    {
        isStepTwo = false;
        message = "";
    }
}