@page "/employees"
@using PayrollDemo.Core.Entities
@using PayrollDemo.Core.Interfaces
@using PayrollDemo.Components.Shared
@inject IEmployeeService EmployeeService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<PageTitle>Finac | Employee Master</PageTitle>

<div class="bar glass">
    <button type="button" class="frost-btn pri" @onclick="HandleAdd" disabled="@isEditMode">
        + Add employee
    </button>
    <button type="button" class="frost-btn" @onclick="HandleEdit" disabled="@(isEditMode || selectedEmployee == null)">
        ✎ Edit
    </button>
    <button type="button" class="frost-btn dng" @onclick="HandleDelete" disabled="@(isEditMode || selectedEmployee == null)">
        Delete
    </button>

    <span class="sp"></span>

    <button type="button" class="frost-btn" @onclick="HandleUndo" disabled="@(!isEditMode)">
        Undo
    </button>
    <button type="button" class="frost-btn pri" @onclick="HandleSave" disabled="@(!isEditMode)">
        Save changes
    </button>
    <button type="button" class="frost-btn" @onclick="HandleClose" disabled="@isEditMode">
        Close
    </button>
</div>

<div class="cols">
    <!-- Left: Data List (Split View) -->
    <section class="list glass">
        <h2>
            Employees 
            <span>@(FilteredEmployees?.Count() ?? 0) total</span>
        </h2>
        <div class="search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"/>
                <path d="m20 20-3.5-3.5"/>
            </svg>
            <input type="search" 
                   placeholder="Search by name, number or department" 
                   aria-label="Search employees" 
                   value="@searchTerm"
                   @oninput="@(e => searchTerm = e.Value?.ToString() ?? "")"
                   disabled="@isEditMode" />
        </div>
        <div class="rows anim">
            @if (employees == null)
            {
                <p style="padding: 16px; color: var(--mute);">Loading...</p>
            }
            else if (FilteredEmployees?.Any() != true)
            {
                <p style="padding: 16px; color: var(--mute);">No employees match your search.</p>
            }
            else
            {
                @foreach (var (emp, index) in (FilteredEmployees ?? Enumerable.Empty<Employee>()).Select((e, i) => (e, i)))
                {
                    var isSelected = selectedEmployee?.EmpNo == emp.EmpNo;
                    <button type="button" 
                            class="emp @(isSelected ? "on" : "")" 
                            style="--i: @index;"
                            @onclick="() => SelectEmployee(emp)" 
                            disabled="@isEditMode">
                        <span class="av" style="--h: @(((emp.EmpNo?.GetHashCode() ?? 0) % 360 + 360) % 360)">
                            @($"{emp.FirstName?.FirstOrDefault()}{emp.LastName?.FirstOrDefault()}".ToUpper())
                        </span>
                        <span>
                            <b>@(string.IsNullOrWhiteSpace($"{emp.FirstName} {emp.LastName}") ? "New employee" : $"{emp.FirstName} {emp.LastName}")</b>
                            <small>#@emp.EmpNo</small>
                        </span>
                        <span class="tag">@emp.DepartmentCode</span>
                    </button>
                }
            }
        </div>
    </section>

    <!-- Right: Employee Detail -->
    <section class="detail glass @(isEditMode ? "editing" : "")">
        @if (selectedEmployee == null && !isAdding)
        {
            <p style="color: var(--mute); padding: 20px;">Select an employee or add a new one.</p>
        }
        else
        {
            <div class="head">
                <span class="av" style="--h: @(((editModel.EmpNo?.GetHashCode() ?? 0) % 360 + 360) % 360)">
                    @($"{editModel.FirstName?.FirstOrDefault()}{editModel.LastName?.FirstOrDefault()}".ToUpper())
                </span>
                <div>
                    <h1>@(string.IsNullOrWhiteSpace($"{editModel.FirstName} {editModel.LastName}") ? (isAdding ? "New employee" : "Unnamed Employee") : $"{editModel.FirstName} {editModel.LastName}")</h1>
                    <p>
                        @(string.IsNullOrWhiteSpace(editModel.DepartmentCode) ? "No Dept" : editModel.DepartmentCode) · #@(string.IsNullOrWhiteSpace(editModel.EmpNo) ? "—" : editModel.EmpNo) &nbsp;
                        <span class="status">@(editModel.ResignDate.HasValue ? "Resigned" : "Active")</span>
                    </p>
                </div>
                <div class="pay">
                    <small>Basic salary</small>
                    <strong>@($"LKR {editModel.BasicSalary:N2}")</strong>
                </div>
            </div>

            <EditForm Model="editModel">
                <div class="sec">
                    <h3>Basic information</h3>
                    <div class="grid">
                        <label>
                            Employee number
                            <InputText @bind-Value="editModel.EmpNo" class="in" readonly="@(!isAdding)" />
                        </label>
                        <label>
                            First name
                            <InputText @bind-Value="editModel.FirstName" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            Last name
                            <InputText @bind-Value="editModel.LastName" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            NIC number
                            <InputText @bind-Value="editModel.NicNo" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            Department
                            <InputSelect @bind-Value="editModel.DepartmentCode" class="in" disabled="@(!isEditMode)">
                                <option value="">-- Select department --</option>
                                <option value="IT">Information Technology</option>
                                <option value="HR">Human Resources</option>
                                <option value="FIN">Finance</option>
                                <option value="OPS">Operations</option>
                            </InputSelect>
                        </label>
                    </div>
                </div>

                <div class="sec">
                    <h3>Employment details</h3>
                    <div class="grid">
                        <label>
                            Join date
                            <InputDate @bind-Value="editModel.JoinDate" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            Resign date
                            <InputDate @bind-Value="editModel.ResignDate" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            Basic salary (LKR)
                            <InputNumber @bind-Value="editModel.BasicSalary" class="in" readonly="@(!isEditMode)" />
                        </label>
                    </div>
                </div>

                <div class="sec">
                    <h3>Banking details</h3>
                    <div class="grid">
                        <label>
                            Bank code
                            <InputText @bind-Value="editModel.BankCode" class="in" readonly="@(!isEditMode)" />
                        </label>
                        <label>
                            Account number
                            <InputText @bind-Value="editModel.BankAccountNumber" class="in" readonly="@(!isEditMode)" />
                        </label>
                    </div>
                </div>
            </EditForm>
        }
    </section>
</div>

@code {
    private List<Employee> employees = new();
    private Employee? selectedEmployee;
    private Employee editModel = new();
    
    private string searchTerm = "";
    private bool isEditMode = false;
    private bool isAdding = false;

    // Local Search Filter
    private IEnumerable<Employee> FilteredEmployees =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? employees
            : employees.Where(e => e.EmpNo.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                                   e.FirstName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        employees = await EmployeeService.GetAllEmployeesAsync();
        if (employees.Any())
        {
            SelectEmployee(employees.First());
        }
    }

    private void SelectEmployee(Employee emp)
    {
        selectedEmployee = emp;
        // Map data to the editable model so UI reflects selection
        editModel = new Employee
        {
            EmpNo = emp.EmpNo,
            FirstName = emp.FirstName,
            LastName = emp.LastName,
            NicNo = emp.NicNo,
            JoinDate = emp.JoinDate,
            ResignDate = emp.ResignDate,
            BasicSalary = emp.BasicSalary,
            DepartmentCode = emp.DepartmentCode,
            BankCode = emp.BankCode,
            BankAccountNumber = emp.BankAccountNumber
        };
    }

    // --- Toolbar Handlers ---

    private void HandleAdd()
    {
        isEditMode = true;
        isAdding = true;
        selectedEmployee = null;
        editModel = new Employee { JoinDate = DateTime.Today }; // Clear the form
    }

    private void HandleEdit()
    {
        isEditMode = true;
        isAdding = false;
    }

    private async Task HandleDelete()
    {
        if (selectedEmployee != null)
        {
            await EmployeeService.DeleteEmployeeAsync(selectedEmployee.EmpNo);
            await LoadDataAsync();
        }
    }

  private async Task HandleSave()
    {
        // 1. Cache the Employee Number before anything gets overwritten
        string savedEmpNo = editModel.EmpNo;

        // 2. Save to database
        if (isAdding)
        {
            await EmployeeService.AddEmployeeAsync(editModel);
        }
        else
        {
            await EmployeeService.UpdateEmployeeAsync(editModel);
        }

        isEditMode = false;
        isAdding = false;
        
        // 3. Refresh the list (this will temporarily select Employee #1 behind the scenes)
        await LoadDataAsync();
        
        // 4. Instantly override it by finding and selecting the cached employee
        var employeeToSelect = employees.FirstOrDefault(e => e.EmpNo == savedEmpNo);
        if (employeeToSelect != null)
        {
            SelectEmployee(employeeToSelect);
        }
    }

    private void HandleUndo()
    {
        isEditMode = false;
        isAdding = false;
        
        if (selectedEmployee != null)
        {
            SelectEmployee(selectedEmployee); // Revert to original
        }
        else if (employees.Any())
        {
            SelectEmployee(employees.First());
        }
    }

    private void HandleClose()
    {
        NavManager.NavigateTo("/dashboard");
    }
}